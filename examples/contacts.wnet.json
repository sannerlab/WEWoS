   {
    "id": "n9",
    "name": "residues near the pick",
    "cls": "Generic",
    "lib": "Standard",
    "pos": [
     1090,
     330
    ],
    "label": "Generic",
    "addPorts": {
     "in": [
      {
       "name": "picked",
       "datatype": "AtomSet",
       "required": true,
       "singleConnection": true
      },
      {
       "name": "molecule",
       "datatype": "Molecule",
       "required": true,
       "singleConnection": true
      },
      {
       "name": "cutoff",
       "datatype": "float",
       "required": true,
       "singleConnection": true
      }
     ],
     "out": [
      {
       "name": "contacts",
       "datatype": "None"
      },
      {
       "name": "names",
       "datatype": "None"
      },
      {
       "name": "distances",
       "datatype": "None"
      },
      {
       "name": "where",
       "datatype": "None"
      },
      {
       "name": "table",
       "datatype": "None"
      }
     ]
    },
    "code": "def doit(self, picked, molecule, cutoff):\n    # the residues with an atom within cutoff (Angstrom) of the picked residue\n    import numpy\n    ag = molecule._ag\n    xyz, resi = ag.getCoords(), ag.getResindices()\n    r0 = int(picked.getResindices()[0])\n    near = xyz[resi == r0]\n    others = numpy.nonzero((resi != r0) & ag.getFlags('protein'))[0]\n    d = numpy.sqrt(((xyz[others, None, :] - near[None, :, :]) ** 2).sum(-1)).min(1)\n    best = {}\n    for i, di in zip(others, d):\n        if di <= cutoff and di < best.get(resi[i], 1e9):\n            best[resi[i]] = di\n    order = sorted(best, key=best.get)\n    first = [numpy.nonzero(resi == r)[0][0] for r in order]\n    names = ['%s%d %s' % (ag.getResnames()[i], ag.getResnums()[i], ag.getChids()[i])\n             for i in first]\n    ca = [numpy.nonzero((resi == r) & (ag.getNames() == 'CA'))[0] for r in order]\n    where = [xyz[c[0]] if len(c) else xyz[i] for c, i in zip(ca, first)]\n    lines = ['residue,min_distance_A\\n'] + ['%s,%.2f\\n' % (n, best[r]) for n, r in zip(names, order)]\n    contacts = molecule.select('resindex ' + ' '.join(str(r) for r in order)) if order else None\n    self.outputData(contacts=contacts, names=names, distances=[float(best[r]) for r in order],\n                    where=where, table=lines)\n"
   },
