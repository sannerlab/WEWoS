    "widgetOpts": {
     "directory": {
      "title": "Select directory"
     }
    },
    "code": "def doit(self, directory, match_str ):\n    import glob, os\n    if directory is not None:\n        cwd = os.getcwd()\n        os.chdir(directory)\n    try:\n        values = glob.glob(match_str)\n        values.sort()\n        filenames = [ os.path.join(directory, x) for x in values ]\n        self.outputData(filelist=filenames)\n    finally:\n        if directory is not None:\n            os.chdir(cwd)\n"
   }
